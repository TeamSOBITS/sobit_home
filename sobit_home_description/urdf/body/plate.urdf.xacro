<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:macro name="plate" params="prefix parent">

    <joint name="${prefix}_bottom_joint" type="fixed">
      <origin xyz="0 0 -0.11" rpy="0.0 0.0 0.0" />
      <parent link="${prefix}_middle_link" />
      <child link="${prefix}_bottom_link" />
    </joint>

    <link name="${prefix}_bottom_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/body/mobile_platform_bottom.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.47 0.19 0.20" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="5.0" /> <!-- TODO -->
        <inertia ixx="${1/12*5.0*(0.19**2+0.20**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*5.0*(0.20**2+0.47**2)}" iyz="0.0"
                 izz="${1/12*5.0*(0.47**2+0.19**2)}" />
      </inertial>
    </link>


    <joint name="${prefix}_middle_joint" type="fixed">
      <origin xyz="0.0 0.0 0.271358" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_middle_link" />
    </joint>

    <link name="${prefix}_middle_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/body/mobile_platform_middle.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.47 0.47 0.02" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" /> <!-- TODO -->
        <inertia ixx="${1/12*1.0*(0.47**2+0.02**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*1.0*(0.02**2+0.47**2)}" iyz="0.0"
                 izz="${1/12*1.0*(0.47**2+0.47**2)}" />
      </inertial>
    </link>
    

    <joint name="${prefix}_top_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0997" rpy="0.0 0.0 0.0" />
      <parent link="${prefix}_middle_link" />
      <child link="${prefix}_top_link" />
    </joint>

    <link name="${prefix}_top_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/body/mobile_platform_top.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.47 0.47 0.02" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.5" /> <!-- TODO -->
        <inertia ixx="${1/12*1.5*(0.47**2+0.02**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*1.5*(0.02**2+0.47**2)}" iyz="0.0"
                 izz="${1/12*1.5*(0.47**2+0.47**2)}" />
      </inertial>
    </link>

  </xacro:macro>
</robot>
