<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:include filename="$(find sobit_home_description)/urdf/body/body.transmission.xacro" />
  <xacro:macro name="body" params="prefix parent" >
  
    <joint name="${prefix}_joint" type="fixed" >
      <origin xyz="0.0 0.0 0.565" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
    </joint>

    <link name="${prefix}_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/body/body.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 0.00425 -0.018" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.0675 0.085 1.07"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.00425 -0.018" rpy="0.0 0.0 0.0" />
        <mass value="0.732" />
        <inertia ixx="${1/12*0.732*(0.085**2+1.07**2)}"  ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.732*(1.07**2+0.0675**2)}" iyz="0.0"
                 izz="${1/12*0.732*(0.0675**2+0.085**2)}" />
      </inertial>
    </link>

    <joint name="${prefix}_lift_joint" type="prismatic" >
      <origin xyz="0.11275 0.0 0.0" rpy="0.0 0.0 0.0" />
      <parent link="${prefix}_link" />
      <child link="${prefix}_lift_link" />
      <axis xyz="0.0 0.0 1.0" />
      <limit lower="-0.4" upper="0.4" effort="150000.0" velocity="0.1" />
    </joint>

    <link name="${prefix}_lift_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/body/linear_actuator.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.15 0.35 0.15"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="0.732" />
        <inertia ixx="${1/12*0.732*(0.35**2+0.15**2)}"  ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.732*(0.15**2+0.15**2)}"  iyz="0.0"
                 izz="${1/12*0.732*(0.15**2+0.35**2)}" />
      </inertial>
    </link>

    <xacro:body_transmission prefix="${prefix}" />

  </xacro:macro>
</robot>
