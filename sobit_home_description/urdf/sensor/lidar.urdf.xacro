<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="lidar_edge" params="prefix parent stand_x stand_y stand_z hokuyo_x hokuyo_y hokuyo_z yaw">

    <joint name="${prefix}_base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_base_link" />
      <origin xyz="${stand_x} ${stand_y} ${stand_z}" rpy="0.0 0.0 ${yaw-M_PI/2}" />
    </joint>

    <link name="${prefix}_base_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/sensor/lidar_stand_edge.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="${0.092/2} 0.0 -${0.007/2}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.092 0.184 0.007"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${0.092/2} 0.0 -${0.007/2}" rpy="0.0 0.0 0.0" />
        <mass value="0.08" />
        <inertia ixx="${1/12*0.08*(0.092**2+0.007**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.08*(0.184**2+0.007**2)}" iyz="0.0"
                 izz="${1/12*0.08*(0.092**2+0.184**2)}" />
      </inertial>
    </link>


    <xacro:hokuyo_ust_mount prefix="${prefix}" parent="${prefix}_base_link" topic="scan" >
      <origin xyz="${hokuyo_x} ${hokuyo_y} ${hokuyo_z}" rpy="0.0 0.0 0.0" />
    </xacro:hokuyo_ust_mount>

  </xacro:macro>


  <xacro:macro name="lidar" params="parent prefix">
  
    <xacro:lidar_edge parent="${parent}" prefix="${prefix}_lf" stand_x= " 0.2357767" stand_y=" 0.2357767" stand_z="0.01" hokuyo_x="0.06914214" hokuyo_y=" 0.0" hokuyo_z="-0.142" yaw="${M_PI-M_PI/4}"/>
    <xacro:lidar_edge parent="${parent}" prefix="${prefix}_rb" stand_x= "-0.2357767" stand_y="-0.2357767" stand_z="0.01" hokuyo_x="0.06914214" hokuyo_y="0.0" hokuyo_z="-0.142" yaw="${-M_PI/4}"/>

  </xacro:macro>
</robot>
