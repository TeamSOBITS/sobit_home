<?xml version="1.0" encoding="UTF-8" ?>
<!-- ELP-USBGS1200P01-H120 USB Global Shutter Camera
     Sensor: Aptina AR0234 (1/2.6"), 1920x1200 @ 90fps MJPEG
     Lens: M12 no-distortion, HFOV 126 deg / VFOV ~84 deg / DFOV ~148 deg
     Board: 38x38mm -->
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="camera_hand" params="prefix parent *origin">

    <joint name="${prefix}_camera_base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_camera_base_link" />
      <xacro:insert_block name="origin" />
    </joint>

    <link name="${prefix}_camera_base_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 -${M_PI/2} ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/sensor/hand_cam_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <!-- <inertial>
        <origin xyz="${0.092/2} 0.0 -${0.007/2}" rpy="0.0 0.0 0.0" />
        <mass value="0.172" />
        <inertia ixx="${1/12*0.172*(0.092**2+0.007**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.172*(0.184**2+0.007**2)}" iyz="0.0"
                 izz="${1/12*0.172*(0.092**2+0.184**2)}" />
      </inertial> -->
    </link>

    <!-- Mount joint: offset from parent (wrist_roll_link) to camera body -->
    <joint name="${prefix}_camera_joint" type="fixed">
      <parent link="${prefix}_camera_base_link" />
      <child link="${prefix}_camera_link" />
      <origin xyz="0.07755813 0.02552260 -0.022120" rpy="${M_PI/4} -${M_PI/2} 0.0" />
    </joint>

    <!-- Camera body link (visual/collision mesh to be added later) -->
    <link name="${prefix}_camera_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/sensor/cam_elp.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <!-- <inertial>
        <origin xyz="${0.092/2} 0.0 -${0.007/2}" rpy="0.0 0.0 0.0" />
        <mass value="0.172" />
        <inertia ixx="${1/12*0.172*(0.092**2+0.007**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.172*(0.184**2+0.007**2)}" iyz="0.0"
                 izz="${1/12*0.172*(0.092**2+0.184**2)}" />
      </inertial> -->
    </link>

    <!-- Optical frame: z forward, x right, y down (ROS convention) -->
    <joint name="${prefix}_camera_optical_joint" type="fixed">
      <parent link="${prefix}_camera_link" />
      <child link="${prefix}_camera_optical_frame" />
      <!-- <origin xyz="0.00285 0.0 0.0" rpy="0.0 0.0 0.0" /> -->
      <origin xyz="0.0 0.0285 0.0" rpy="-${M_PI/2} 0.0 0.0" />
    </joint>

    <link name="${prefix}_camera_optical_frame" />

  </xacro:macro>
</robot>
