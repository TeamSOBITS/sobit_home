<?xml version="1.0" encoding="UTF-8" ?>
<!-- Head camera: Intel RealSense D415 (head_cam_type:=realsense). Same camera_head macro
     signature as camera_head_orbbec.urdf.xacro; the driver runs with publish_tf:=false. -->
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find realsense2_description)/urdf/_d415.urdf.xacro" />
  <xacro:macro name="camera_head" params="prefix parent">

    <joint name="${prefix}_camera_base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_camera_base_link" />
      <origin xyz="0.0398 0.0 0.074" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="${prefix}_camera_base_link"/>

    <!-- Origin = D415 bottom tripod screw, placed where the Orbbec screw frame sat.
         TODO: verify against the real camera in rviz. -->
    <xacro:sensor_d415 parent="${prefix}_camera_base_link" name="${prefix}_camera" use_nominal_extrinsics="true">
      <origin xyz="0.01120544 0.0 -0.01211253" rpy="0 0 0"/>
    </xacro:sensor_d415>

  </xacro:macro>
</robot>
