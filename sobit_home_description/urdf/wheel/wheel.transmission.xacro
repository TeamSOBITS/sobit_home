<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wheel_transmission" params="prefix">

    <xacro:SimpleTransmissionPosition joint="${prefix}_steer_f_l_joint" reduction="1" />
    <xacro:SimpleTransmissionPosition joint="${prefix}_steer_f_r_joint" reduction="1" />
    <xacro:SimpleTransmissionPosition joint="${prefix}_steer_b_l_joint" reduction="1" />
    <xacro:SimpleTransmissionPosition joint="${prefix}_steer_b_r_joint" reduction="1" />

    <xacro:SimpleTransmissionVelocity joint="${prefix}_drive_f_l_joint" reduction="1" />
    <xacro:SimpleTransmissionVelocity joint="${prefix}_drive_f_r_joint" reduction="1" />
    <xacro:SimpleTransmissionVelocity joint="${prefix}_drive_b_l_joint" reduction="1" />
    <xacro:SimpleTransmissionVelocity joint="${prefix}_drive_b_r_joint" reduction="1" />

  </xacro:macro>
</robot>
