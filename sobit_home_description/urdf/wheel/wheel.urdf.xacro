<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find sobit_home_description)/urdf/wheel/wheel.transmission.xacro" />

  <xacro:macro name="stack_wheel_steer_base" params="parent id x_loc y_loc z_loc roll=0.0 pitch=0.0 yaw=0.0">

    <joint name="wheel_steer_base_${id}_joint" type="fixed">
      <origin xyz="${x_loc} ${y_loc} ${z_loc}" rpy="${roll} ${pitch} ${yaw}" />
      <parent link="${parent}" />
      <child link="wheel_steer_base_${id}_link" />
    </joint>

    <link name="wheel_steer_base_${id}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/wheel/wheel_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <cylinder length="0.0797" radius="0.075"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <mass value="0.877" /> <!-- mass without frame and robomaster -->
        <inertia ixx="${1/12*0.877*(3*0.075**2+0.0797**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.877*(3*0.075**2+0.0797**2)}" iyz="0.0"
                 izz="${1/2*0.877*0.075**2}" />
      </inertial>
    </link>
    
  </xacro:macro>


  <xacro:macro name="stack_wheel_steer" params="parent id x_loc y_loc z_loc roll=0.0 pitch=0.0 yaw=0.0">

    <joint name="wheel_steer_${id}_joint" type="revolute">
      <origin xyz="${x_loc} ${y_loc} ${z_loc}" rpy="${roll} ${pitch} ${yaw}" />
      <parent link="${parent}" />
      <child link="wheel_steer_${id}_link" />
      <axis xyz="0.0 0.0 1.0 " />
      <limit effort="10.0" velocity="1.0" lower="${-M_PI*2}" upper="${M_PI*2}" />
      <!-- <dynamics damping="0.2" friction="0" /> -->
    </joint>

    <link name="wheel_steer_${id}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/wheel/wheel_steer.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 -0.030925" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <box size="0.1 0.1 0.06185" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 -0.030925" rpy="0.0 0.0 ${M_PI/2}" />
        <mass value="0.889" /> <!-- mass without timing belt and others -->
        <inertia ixx="${1/12*0.889*(0.1**2+0.06185**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.889*(0.06185**2+0.1**2)}" iyz="0.0"
                 izz="${1/12*0.889*(0.1**2+0.1**2)}" />
      </inertial>
    </link>

  </xacro:macro>


  <xacro:macro name="stack_wheel_drive" params="parent id x_loc y_loc z_loc roll=0.0 pitch=0.0 yaw=0.0">

    <joint name="wheel_drive_${id}_joint" type="continuous">
      <origin xyz="${x_loc+0.0019} ${y_loc} ${z_loc}" rpy="${roll} ${pitch} ${yaw}" />
      <parent link="${parent}" />
      <child link="wheel_drive_${id}_link" />
      <axis xyz="0.0 1.0 0.0 " />
      <limit effort="10.0" velocity="10.0" />
    </joint>

    <link name="wheel_drive_${id}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="${M_PI/2.0} 0.0 ${M_PI}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/wheel/wheel_drive.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="wheel" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="${M_PI/2.0} 0.0 ${M_PI}" />
        <geometry>
          <cylinder length="0.017" radius="0.075"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="${M_PI/2.0} 0.0 ${M_PI}" />
        <mass value="0.5" /> <!-- TODO -->
        <inertia ixx="${1/12*0.5*(3*0.075**2+0.017**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.5*(3*0.075**2+0.017**2)}" iyz="0.0"
                 izz="${1/2*0.5*0.075**2}" />
      </inertial>
    </link>

  </xacro:macro>


  <xacro:macro name="wheel" params="parent prefix">
  
    <xacro:stack_wheel_steer_base parent="${parent}" id="f_r" x_loc= " 0.176" y_loc= "-0.176" z_loc="0.0473"/>
    <xacro:stack_wheel_steer_base parent="${parent}" id="f_l" x_loc= " 0.176" y_loc= " 0.176" z_loc="0.0473"/>
    <xacro:stack_wheel_steer_base parent="${parent}" id="b_r" x_loc= "-0.176" y_loc= "-0.176" z_loc="0.0473" yaw="${M_PI}"/>
    <xacro:stack_wheel_steer_base parent="${parent}" id="b_l" x_loc= "-0.176" y_loc= " 0.176" z_loc="0.0473" yaw="${M_PI}"/>

    <xacro:stack_wheel_steer parent="${prefix}_steer_base_f_r_link" id="f_r" x_loc= "0.0" y_loc= "0.0" z_loc="-0.09545"/>
    <xacro:stack_wheel_steer parent="${prefix}_steer_base_f_l_link" id="f_l" x_loc= "0.0" y_loc= "0.0" z_loc="-0.09545"/>
    <xacro:stack_wheel_steer parent="${prefix}_steer_base_b_r_link" id="b_r" x_loc= "0.0" y_loc= "0.0" z_loc="-0.09545"/>
    <xacro:stack_wheel_steer parent="${prefix}_steer_base_b_l_link" id="b_l" x_loc= "0.0" y_loc= "0.0" z_loc="-0.09545"/>

    <xacro:stack_wheel_drive parent="${prefix}_steer_f_r_link" id="f_r" x_loc= "0.0" y_loc= "0.0" z_loc="-0.148208"/>
    <xacro:stack_wheel_drive parent="${prefix}_steer_f_l_link" id="f_l" x_loc= "0.0" y_loc= "0.0" z_loc="-0.148208"/>
    <xacro:stack_wheel_drive parent="${prefix}_steer_b_r_link" id="b_r" x_loc= "0.0" y_loc= "0.0" z_loc="-0.148208" yaw="${M_PI}"/>
    <xacro:stack_wheel_drive parent="${prefix}_steer_b_l_link" id="b_l" x_loc= "0.0" y_loc= "0.0" z_loc="-0.148208" yaw="${M_PI}"/>

    <xacro:wheel_transmission prefix="${prefix}" />

  </xacro:macro>
</robot>
