<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:include filename="$(find sobit_home_description)/urdf/arm/arm.transmission.xacro" />

  <xacro:macro name="arm" params="prefix position parent" >
    <xacro:if value="${position == 'left'}">
      <xacro:property name="y_sign" value="1.0" />
    </xacro:if>
    <xacro:if value="${position == 'right'}">
      <xacro:property name="y_sign" value="-1.0" />
    </xacro:if>

    <joint name="${prefix}_${position}_base_joint" type="fixed" >
      <parent link="${parent}" />
      <child link="${prefix}_${position}_base_link" />
      <origin xyz="0.178 ${y_sign * 0.079} 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="${prefix}_${position}_base_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 ${(y_sign+1) * M_PI/2} ${-M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_scapula.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 ${y_sign * 0.124/2} 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.054 0.124 0.054" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.124/2} 0.0" rpy="0.0 0.0 0.0" />
        <mass value="0.855" /> <!-- mass without FRP54-A110K -->
        <inertia ixx="${1/12*0.855*(0.124**2+0.054**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.855*(0.054**2+0.054**2)}" iyz="0.0"
                 izz="${1/12*0.855*(0.054**2+0.124**2)}" />
      </inertial>
    </link>


<!-- Shoulder tilt joint -->
    <joint name="${prefix}_${position}_shoulder_tilt_joint" type="revolute" >
      <parent link="${prefix}_${position}_base_link" />
      <child link="${prefix}_${position}_shoulder_tilt_link" />
      <origin xyz="0.0 ${y_sign * 0.126} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 ${y_sign} 0.0" />
      <limit lower="${-M_PI}" upper="${M_PI}" effort="${44.7 * effort_ratio}" velocity="3.0" />
    </joint>

    <link name="${prefix}_${position}_shoulder_tilt_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${y_sign * M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_shoulder.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 ${y_sign * 0.104/2} 0.0" rpy="${y_sign * M_PI/2} 0.0 0.0" />
        <geometry>
          <cylinder length="0.104" radius="${0.08/2}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 ${y_sign * 0.104/2} 0.0" rpy="${y_sign * M_PI/2} 0.0 0.0" />
        <mass value="0.504" />
        <inertia ixx="${1/12*0.504*(3*0.04**2+0.104**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.504*(3*0.04**2+0.104**2)}" iyz="0.0"
                 izz="${1/2*0.504*0.04**2}" />
      </inertial>
    </link>


<!-- Upper roll joint (left) -->
    <joint name="${prefix}_${position}_upper_roll_joint" type="revolute" >
      <parent link="${prefix}_${position}_shoulder_tilt_link" />
      <child link="${prefix}_${position}_upper_roll_link" />
      <origin xyz="${-y_sign * 0.0510} ${y_sign * 0.100} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="1.0 0.0 0.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${10.6 * effort_ratio}" velocity="3.14" />
    </joint>

    <link name="${prefix}_${position}_upper_roll_link" >
      <visual>
        <xacro:if value="${position == 'right'}">
          <origin xyz="${y_sign * 0.0510} 0.0 0.0" rpy="${M_PI} 0.0 ${y_sign * M_PI/2}" />
        </xacro:if>
        <xacro:unless value="${position == 'right'}">
          <origin xyz="${y_sign * 0.0510} 0.0 0.0" rpy="0.0 0.0 ${y_sign * M_PI/2}" />
        </xacro:unless>
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_upper_roll.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="${-y_sign * 0.0563} ${y_sign * 0.13445} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${M_PI/2}" />
        <geometry>
          <cylinder length="0.129" radius="${0.076/2}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.13445} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${M_PI/2}" />
        <mass value="0.595" />
        <inertia ixx="${1/12*0.595*(3*0.038**2+0.129**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.595*(3*0.038**2+0.129**2)}" iyz="0.0"
                 izz="${1/2*0.595*0.038**2}" />
      </inertial>
    </link>

<!-- Upper roll sub joint -->
    <joint name="${prefix}_${position}_upper_roll_sub_joint" type="revolute" >
      <mimic joint="${prefix}_${position}_upper_roll_joint" multiplier="-1" offset="0"/>
      <parent link="${prefix}_${position}_shoulder_tilt_link" />
      <child link="${prefix}_${position}_upper_roll_sub_link" />
      <origin xyz="${y_sign * 0.0510} ${y_sign * 0.100} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="-1.0 0.0 0.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${10.6 * effort_ratio}" velocity="3.14" />
    </joint>

    <link name="${prefix}_${position}_upper_roll_sub_link" >
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.13445} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${M_PI/2}" />
        <mass value="0.595" />
        <inertia ixx="${1/12*0.595*(3*0.038**2+0.129**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.595*(3*0.038**2+0.129**2)}" iyz="0.0"
                 izz="${1/2*0.595*0.038**2}" />
      </inertial>
    </link>
  

  <!-- Upper flex joint -->
    <joint name="${prefix}_${position}_upper_flex_joint" type="revolute" >
      <parent link="${prefix}_${position}_upper_roll_link" />
      <child link="${prefix}_${position}_upper_flex_link" />
      <origin xyz="${y_sign * 0.0510} ${y_sign * 0.1335} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 ${y_sign} 0.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${10.6 * effort_ratio}" velocity="4.81" />
    </joint>

    <link name="${prefix}_${position}_upper_flex_link" >
      <visual>
          <origin xyz="0.0 ${y_sign * 0.0212} 0.0" rpy="${-y_sign *M_PI/2} 0.0 ${y_sign * M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_upper_flex.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 ${y_sign * 0.06943603} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${-M_PI/2}" />
        <geometry>
          <cylinder length="0.171" radius="${0.076/2}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.06943603} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${-M_PI/2}" />
        <mass value="0.778" />
        <inertia ixx="${1/12*0.778*(3*0.038**2+0.171**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.778*(3*0.038**2+0.171**2)}" iyz="0.0"
                 izz="${1/2*0.778*0.038**2}" />
      </inertial>
    </link>

<!-- Upper flex sub joint -->
    <joint name="${prefix}_${position}_upper_flex_sub_joint" type="revolute" >
      <mimic joint="${prefix}_${position}_upper_flex_joint" multiplier="1" offset="0"/>
      <parent link="${prefix}_${position}_upper_roll_link" />
      <child link="${prefix}_${position}_upper_flex_sub_link" />
      <origin xyz="${y_sign * 0.0510} ${y_sign * (0.100+0.0335+0.0510)} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 ${y_sign} 0.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${10.6 * effort_ratio}" velocity="4.81" />
    </joint>

    <link name="${prefix}_${position}_upper_flex_sub_link" >
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.06943603} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${-M_PI/2}" />
        <mass value="0.778" />
        <inertia ixx="${1/12*0.778*(3*0.038**2+0.171**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.778*(3*0.038**2+0.171**2)}" iyz="0.0"
                 izz="${1/2*0.778*0.038**2}" />
      </inertial>
    </link>


<!-- Lower top joint -->
    <joint name="${prefix}_${position}_lower_top_joint" type="revolute" >
      <parent link="${prefix}_${position}_upper_flex_link" />
      <child link="${prefix}_${position}_lower_top_link" />
      <axis xyz="0.0 0.0 1.0" />
      <origin xyz="0.05495 ${y_sign * 0.26365} ${y_sign * 0.0510}" rpy="0.0 0.0 0.0" />
        <limit lower="${-M_PI/2}" upper="${2/3 * M_PI}" effort="${10.6 * effort_ratio}" velocity="3.14" />
    </joint>

    <link name="${prefix}_${position}_lower_top_link" >
      <visual>
        <xacro:if value="${position == 'right'}">
          <origin xyz="0.0 0.0 ${y_sign * -0.0510}" rpy="${M_PI} 0.0 ${-M_PI/2}" />
        </xacro:if>
        <xacro:unless value="${position == 'right'}">
          <origin xyz="0.0 0.0 ${-y_sign * 0.0510}" rpy="0.0 0.0 ${M_PI/2}" />
        </xacro:unless>
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_lower_top.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder length="0.386" radius="${0.088156/2}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.265} 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <mass value="1.663" /> <!--mass without FR13-H101K -->
        <inertia ixx="${1/12*1.663*(3*0.044**2+0.386**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*1.663*(3*0.044**2+0.386**2)}" iyz="0.0"
                 izz="${1/2*1.663*0.044**2}" />
      </inertial>
    </link>

<!-- Lower top sub joint -->
    <joint name="${prefix}_${position}_lower_top_sub_joint" type="revolute" >
      <mimic joint="${prefix}_${position}_lower_top_joint" multiplier="-1" offset="0"/>
      <parent link="${prefix}_${position}_upper_flex_link" />
      <child link="${prefix}_${position}_lower_top_sub_link" />
      <origin xyz="0.05495 ${y_sign * 0.26365} ${-y_sign * 0.0510}" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 0.0 -1.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${10.6 * effort_ratio}" velocity="3.14" />
    </joint>

    <link name="${prefix}_${position}_lower_top_sub_link" >
      <inertial>
        <origin xyz="0.0 ${y_sign * 0.265} 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <mass value="1.663" /> 
        <inertia ixx="${1/12*1.663*(3*0.044**2+0.386**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*1.663*(3*0.044**2+0.386**2)}" iyz="0.0"
                 izz="${1/2*1.663*0.044**2}" />
      </inertial>
    </link>


<!-- Lower bottom joint -->
    <joint name="${prefix}_${position}_lower_bottom_joint" type="revolute" >
      <parent link="${prefix}_${position}_lower_top_link" />
      <child link="${prefix}_${position}_lower_bottom_link" />
      <origin xyz="0.0 ${y_sign * 0.107} ${-y_sign * 0.0510}" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 ${y_sign* 1.0} 0.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${4.1 * effort_ratio}" velocity="4.81" />
    </joint>

    <link name="${prefix}_${position}_lower_bottom_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${y_sign * M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_lower_bottom.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 ${y_sign * 0.0462} 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <geometry>
          <cylinder length="0.0453" radius="${0.08/2}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <mass value="0.341" />
        <inertia ixx="${1/12*0.341*(3*0.04**2+0.0453**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.341*(3*0.04**2+0.0453**2)}" iyz="0.0"
                 izz="${1/2*0.341*0.04**2}" />
      </inertial>
    </link>


<!-- TODO -->
<!-- Wrist tilt joint -->
    <joint name="${prefix}_${position}_wrist_tilt_joint" type="revolute" >
      <parent link="${prefix}_${position}_lower_bottom_link" />
      <child link="${prefix}_${position}_wrist_tilt_link" />
      <origin xyz="0.0 ${y_sign * 0.443} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 0.0 1.0" />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="${4.1 * effort_ratio}" velocity="4.81" />
    </joint>

    <link name="${prefix}_${position}_wrist_tilt_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_wrist_tilt.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.0 ${y_sign * 0.0462} 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <geometry>
          <cylinder length="0.0453" radius="${0.08/2}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 ${-y_sign * M_PI/2} ${M_PI/2}" />
        <mass value="0.341" />
        <inertia ixx="${1/12*0.341*(3*0.04**2+0.0453**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.341*(3*0.04**2+0.0453**2)}" iyz="0.0"
                 izz="${1/2*0.341*0.04**2}" />
      </inertial>
    </link>


<!-- Wrist roll joint -->
    <joint name="${prefix}_${position}_wrist_roll_joint" type="revolute" >
      <parent link="${prefix}_${position}_wrist_tilt_link" />
      <child link="${prefix}_${position}_wrist_roll_link" />
      <origin xyz="0.0 ${y_sign * 0.06648202} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 ${y_sign} 0.0" />
      <limit lower="${-M_PI}" upper="${M_PI}" effort="${10.6 * effort_ratio}" velocity="11.031179004" />
    </joint>

    <link name="${prefix}_${position}_wrist_roll_link" >
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 ${y_sign * M_PI/2} ${y_sign * M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/arm/arm_wrist_roll.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <origin xyz="0.00852612 ${y_sign * 0.07450 / 2} 0.0" rpy="0.0 ${y_sign * M_PI/2} ${y_sign * M_PI/2}" />
        <geometry>
          <box size="0.108 0.0826 0.0645" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 ${y_sign * M_PI/2} ${y_sign * M_PI/2}" />
        <mass value="0.016" />
        <inertia ixx="${1/12*0.016*(0.0645**2+0.0826**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.016*(0.108**2 +0.0645**2)}" iyz="0.0"
                 izz="${1/12*0.016*(0.108**2+0.0826**2)}" />
      </inertial>
    </link>

    <xacro:arm_transmission prefix="${prefix}" position="${position}" />

  </xacro:macro>
</robot>
