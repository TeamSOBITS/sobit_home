<?xml version="1.0" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="arm_transmission" params="prefix position" >

    <xacro:position_joint_transmission joint="${prefix}_${position}_shoulder_tilt_joint"    reduction="1" />
    <xacro:position_joint_transmission joint="${prefix}_${position}_upper_roll_joint"    reduction="1" />
    <xacro:position_joint_transmission joint="${prefix}_${position}_uppder_flex_joint"    reduction="1" />
    <xacro:position_joint_transmission joint="${prefix}_${position}_elbow_joint"    reduction="1" />
    <xacro:position_joint_transmission joint="${prefix}_${position}_wrist_joint"    reduction="1" />

  </xacro:macro>
</robot>
