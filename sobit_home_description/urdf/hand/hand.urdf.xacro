<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:include filename="$(find sobit_home_description)/urdf/hand/hand.transmission.xacro" />
  
  <xacro:macro name="hand" params="prefix_hand position prefix_finger parent">

    <joint name="${prefix_hand}_${position}_base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix_hand}_base_link" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="${prefix_hand}_${position}_base_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="${M_PI/2.0} 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/hand/hand_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="${0.0215+(0.08251-0.0215)/2} 0.0 ${(0.0415-0.033)/2}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.06102 0.102 0.0745" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${0.0215+(0.08251-0.0215)/2} 0.0 ${(0.0415-0.033)/2}" rpy="0.0 0.0 ${M_PI/2}" />
        <mass value="0.08" />
        <inertia ixx="${1/12*0.08*(0.06102**2+0.0745**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.08*(0.102**2  +0.0745**2)}" iyz="0.0"
                 izz="${1/12*0.08*(0.06102**2+0.102**2)}" />
      </inertial>
    </link>



    <xacro:hand_transmission prefix_hand="${prefix_hand}" position="${position}" prefix_finger="${prefix_finger}" />

  </xacro:macro>
</robot>
