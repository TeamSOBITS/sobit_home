  <xacro:macro name="dxl_hand_right_controllers"   params="prefix enable_gz:=False">
    <joint name="${prefix}_finger_l_mcp_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">60</param>
        <param name="control_mode">6</param>
        <param name="Goal_Current">300</param>
        <param name="interface">ttl</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-1.7</param>
        <param name="max">1.70</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  
    <xacro:if value="${$(arg enable_gz)}">
      <joint name="${prefix}_finger_r_mcp_joint">
        <state_interface name="position">
