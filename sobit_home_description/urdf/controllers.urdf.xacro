        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-1.570796327</param>
        <param name="max">1.570796327</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>


  <xacro:macro name="dxl_hand_left_controllers"    params="prefix enable_gz:=False">
    <joint name="${prefix}_finger_l_mcp_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">50</param>
        <param name="control_mode">6</param>
        <param name="Goal_Current">300</param>
        <param name="interface">ttl</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-${M_PI/2}</param>
        <param name="max">${M_PI/2}</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <xacro:if value="${$(arg enable_gz)}">
      <joint name="${prefix}_finger_r_mcp_joint">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:if>

    <joint name="${prefix}_finger_l_pip_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">51</param>
        <param name="control_mode">6</param>
        <param name="Goal_Current">150</param>
        <param name="interface">ttl</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-${M_PI/2}</param>
        <param name="max">${M_PI/2}</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="${prefix}_finger_l_dip_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">52</param>
        <param name="control_mode">6</param>
        <param name="Goal_Current">100</param>
