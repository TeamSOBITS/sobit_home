      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}_finger_r_dip_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">66</param>
        <param name="control_mode">6</param>
        <param name="interface">ttl</param>
      </xacro:unless>
      <command_interface name="position">
        <param name="min">-1.570796327</param>
        <param name="max">1.570796327</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </xacro:macro>

  <xacro:macro name="iai_body_controllers"        params="prefix enable_gz:=False">

    <joint name="${prefix}_lift_joint">
      <!-- TODO - Develop IAI controller -->
      <!-- <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">1</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
      </xacro:unless> -->
      <command_interface name="position">
        <param name="min">-0.4</param>
        <param name="max">0.4</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </xacro:macro>

</robot>
