      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">-1.5</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="${prefix}_upper_flex_joint">
      <xacro:unless value="${$(arg enable_gz)}">
        <param name="id">33</param>
        <param name="control_mode">0</param>
        <param name="interface">rs</param>
        <param name="Return_Delay_Time">0</param>
      </xacro:unless>
      <command_interface name="position">
