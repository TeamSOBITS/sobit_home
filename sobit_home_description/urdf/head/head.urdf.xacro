<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_home"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:include filename="$(find sobit_home_description)/urdf/head/head.transmission.xacro" />
  
  <xacro:macro name="head" params="prefix parent">
    <joint name="${prefix}_base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_base_link" />
      <origin xyz="0.193 0.0 0.085" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="${prefix}_base_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/head/neck_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="-0.015 0.0 -${0.01/2}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.15 0.125 0.01"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.015 0.0 -${0.01/2}" rpy="0.0 0.0 0.0" />
        <mass value="0.424" />
        <inertia ixx="${1/12*0.424*(0.125**2+0.01**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.424*(0.01**2 +0.15**2)}" iyz="0.0"
                 izz="${1/12*0.424*(0.15**2+0.125**2)}" />
      </inertial>
    </link>


    <joint name="${prefix}_pan_joint" type="revolute">
      <parent link="${prefix}_base_link" />
      <child link="${prefix}_pan_link" />
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0 0 1" />
      <limit lower="${-M_PI/4.0}" upper="${M_PI/4.0}" effort="${4.1 * effort_ratio}" velocity="4.81" />
    </joint>

    <link name="${prefix}_pan_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/head/neck.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0046" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder length="0.0092" radius="${0.065/2}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0046" rpy="0.0 0.0 0.0" />
        <mass value="0.457" />
        <inertia ixx="${1/12*0.457*(3*0.0325**2+0.0092**2)}"     ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.457*(3*0.0325**2+0.04009253**2)}" iyz="0.0"
                 izz="${1/2*0.457*0.0325**2}" />
      </inertial>
    </link>


    <joint name="${prefix}_tilt_joint" type="revolute">
      <parent link="${prefix}_pan_link" />
      <child link="${prefix}_tilt_link" />
      <origin xyz="0.05 0.0 0.131" rpy="0.0 0.0 0.0" />
      <axis xyz="0 -1 0" />
      <limit lower="${-M_PI/4.0}" upper="${M_PI/6.0}" effort="${4.1 * effort_ratio}" velocity="4.81" />
    </joint>

    <link name="${prefix}_tilt_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/head/head.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/head/ear.dae"/>
        </geometry>
        <!-- <material name="blue" /> -->
      </visual>
      <visual>
        <origin xyz="0.07815 0.05 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/head/eye.dae"/>
        </geometry>
        <!-- <material name="blue" /> -->
      </visual>
      <visual>
        <origin xyz="0.07815 -0.05 0.0" rpy="0.0 0.0 ${M_PI/2.0}" />
        <geometry>
          <mesh filename="file://$(find sobit_home_description)/meshes/head/eye.dae"/>
        </geometry>
        <!-- <material name="blue" /> -->
      </visual>
      <collision>
        <origin xyz="-0.01 0.0 0.00943" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.155 0.278 0.2"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.01 0.0 0.00943" rpy="0.0 0.0 0.0" />
        <mass value="1.88" /> <!-- mass without camera and display-->
        <inertia ixx="${1/12*1.88*(0.278**2 +0.2**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*1.88*(0.2**2+0.155**2)}"  iyz="0.0"
                 izz="${1/12*1.88*(0.155**2 +0.278**2)}" />
      </inertial>
    </link>


    <xacro:head_transmission prefix="${prefix}" />

  </xacro:macro>
</robot>
