  <ros2_control name="dynamixel_pro_upper" type="system">
    <!-- <ros2_control name="dynamixel_pro_upper" type="system" is_async="true">
        <properties>
          <async scheduling_policy="synchronized" thread_priority="79" affinity="[3]" print_warnings="true"/>
        </properties> -->
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="arm_left_shoulder_tilt_joint">
      <command_interface name="position">
        <param name="min">-3.14159265359</param>
        <param name="max">3.14159265359</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.55</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_right_shoulder_tilt_joint">
      <command_interface name="position">
        <param name="min">-3.14159265359</param>
        <param name="max">3.14159265359</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.55</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <ros2_control name="robomaster_control" type="system">
    <!-- <ros2_control name="robomaster_control" type="system" is_async="true">
        <properties>
          <async scheduling_policy="synchronized" thread_priority="79" affinity="[4]" print_warnings="true"/>
        </properties> -->
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="wheel_drive_f_l_joint">
      <param name="motor_id">1</param>
      <param name="motor_type">m3508</param>
      <param name="invert_rotation">true</param>
      <param name="velocity_kp">0.75</param>
      <param name="velocity_ki">1.0</param>
      <param name="velocity_kd">0.001</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
    <joint name="wheel_drive_f_r_joint">
      <param name="motor_id">2</param>
      <param name="motor_type">m3508</param>
      <param name="invert_rotation">false</param>
      <param name="velocity_kp">0.75</param>
      <param name="velocity_ki">1.0</param>
      <param name="velocity_kd">0.001</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
    <joint name="wheel_drive_b_l_joint">
      <param name="motor_id">3</param>
      <param name="motor_type">m3508</param>
      <param name="invert_rotation">true</param>
      <param name="velocity_kp">0.75</param>
      <param name="velocity_ki">1.0</param>
      <param name="velocity_kd">0.001</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
    <joint name="wheel_drive_b_r_joint">
      <param name="motor_id">4</param>
      <param name="motor_type">m3508</param>
      <param name="invert_rotation">false</param>
      <param name="velocity_kp">0.75</param>
      <param name="velocity_ki">1.0</param>
      <param name="velocity_kd">0.001</param>
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
  </ros2_control>
  <!-- rw_rate 20 Hz on real hardware: one read is 2 serial round-trips at 115200
           (~10-30 ms), which can never fit the 50 Hz / 20 ms budget and only produces
           "previous async trigger still in progress" warnings. -->
  <ros2_control is_async="False" name="uirobot_control" rw_rate="50" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="body_lift_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.6</param>
      </command_interface>
      <!-- <command_interface name="velocity"/> -->
      <state_interface name="position">
        <param name="initial_value">0.50</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        <namespace>sobit_home</namespace>
      </ros>
      <parameters>/home/rg-sobit-home/colcon_ws/install/sobit_home_control/share/sobit_home_control/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <gazebo reference="head_camera_color_frame">
    <sensor name="head_camera_color" type="camera">
      <pose>0 0 0 0 0 0 </pose>
      <gz_frame_id>head_camera_color_optical_frame</gz_frame_id>
      <topic>sobit_home/head_camera/color</topic>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera name="head_camera_color">
        <horizontal_fov>1.64061</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
        <!-- TODO - adjust noise -->
        <!-- <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.007</stddev>
            </noise> -->
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="head_camera_depth_frame">
    <sensor name="head_camera_depth" type="depth_camera">
      <pose>0 0 0 0 0 0 </pose>
      <gz_frame_id>head_camera_depth_frame</gz_frame_id>
      <topic>sobit_home/head_camera/depth</topic>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera name="head_camera_depth">
        <horizontal_fov>1.64061</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <!-- TODO - adjust noise -->
        <!-- <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.1</stddev>
            </noise> -->
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="hand_left_camera_optical_frame">
    <sensor name="hand_left_camera_color" type="camera">
      <pose>0 0 0 1.570796326795 -1.570796326795 3.14159265359</pose>
      <gz_frame_id>hand_left_camera_optical_frame</gz_frame_id>
      <topic>sobit_home/hand_left_camera/color</topic>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera name="hand_left_camera_color">
        <!-- ELP-USBGS1200P01-H120: HFOV 126 deg -->
        <horizontal_fov>2.19911</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.01</near>
          <!-- <far>10</far> -->
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="hand_right_camera_optical_frame">
    <sensor name="hand_right_camera_color" type="camera">
      <pose>0 0 0 1.570796326795 -1.570796326795 3.14159265359</pose>
      <gz_frame_id>hand_right_camera_optical_frame</gz_frame_id>
      <topic>sobit_home/hand_right_camera/color</topic>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera name="hand_right_camera_color">
        <!-- ELP-USBGS1200P01-H120: HFOV 126 deg -->
        <horizontal_fov>2.19911</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.01</near>
          <!-- <far>10</far> -->
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <!-- Publish Joint States -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>sobit_home/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
