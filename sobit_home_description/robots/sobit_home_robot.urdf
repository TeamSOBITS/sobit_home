  <!-- <ros2_control name="dynamixel_control_lower" type="system"> -->
  <ros2_control is_async="true" name="dynamixel_control_lower" type="system">
    <properties>
      <async affinity="[1]" print_warnings="true" scheduling_policy="synchronized" thread_priority="79"/>
    </properties>
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="wheel_steer_f_l_joint">
      <command_interface name="position">
        <param name="min">-3.14159265359</param>
        <param name="max">3.14159265359</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_steer_f_r_joint">
      <command_interface name="position">
        <param name="min">-3.14159265359</param>
        <param name="max">3.14159265359</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_steer_b_l_joint">
      <command_interface name="position">
        <param name="min">-3.14159265359</param>
        <param name="max">3.14159265359</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wheel_steer_b_r_joint">
      <command_interface name="position">
        <param name="min">-3.14159265359</param>
        <param name="max">3.14159265359</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
