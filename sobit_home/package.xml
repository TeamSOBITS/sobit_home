<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobit_home</name>
  <version>0.0.0</version>
  <description>
    ROS packages for SOBIT HOME (meta package).
  </description>
  <maintainer email="simjiahao9@gmail.com">Sim Jiahao</maintainer>

  <license>BSD</license>

  <url type="website">https://home.soka.ac.jp/~choi/index.html</url>
  <url type="repository">https://github.com/TeamSOBITS/sobit_home</url>
  <url type="bugtracker">https://github.com/TeamSOBITS/sobit_home/issues</url>
  <author email="choi.7f@gmail.com">Team SOBITS</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <exec_depend>sobit_home_description</exec_depend>
  <exec_depend>sobit_home_bringup</exec_depend>
  <exec_depend>sobit_home_control</exec_depend>
  <exec_depend>sobit_home_library</exec_depend>
  <exec_depend>sobit_home_kinematics_plugin</exec_depend>
  <exec_depend>sobit_home_moveit_config</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>