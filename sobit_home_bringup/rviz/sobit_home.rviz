Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /HeadCam (RGB)1/Topic1
        - /HandLeftCam (RGB)1/Topic1
        - /HandRightCam (RGB)1/Topic1
        - /FrontLiDAR1/Topic1
        - /BackLiDAR1/Topic1
        - /MergedLiDAR1/Topic1
