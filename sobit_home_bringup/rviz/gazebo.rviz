    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5222482681274414
    Tree Height: 636
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
