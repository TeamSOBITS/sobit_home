<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobit_home_bringup</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="ksuzuki9541@gmail.com">sobits</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch-only package: everything below is started from the launch files. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>position_controllers</exec_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>

  <!-- Sensors started by robot.launch.py. -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>urg_node</exec_depend>
  <exec_depend>ros2_laser_scan_merger</exec_depend>
  <exec_depend>usb_cam</exec_depend>

  <exec_depend>sobit_home_description</exec_depend>
  <exec_depend>sobit_home_control</exec_depend>
  <exec_depend>sobit_home_library</exec_depend>
  <exec_depend>sobit_home_moveit_config</exec_depend>
  <exec_depend>sobits_display</exec_depend>
  <exec_depend>sobits_gazebo_worlds</exec_depend>
  <!-- Viewers enable_viz picks from; each is optional at runtime. -->
  <exec_depend>sobits_viz_rviz</exec_depend>
  <exec_depend>sobits_viz_foxglove</exec_depend>
  <exec_depend>sobits_viz_rerun</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
