<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobit_home_moveit_config</name>
  <version>0.3.0</version>
  <description>
     An automatically generated package with all the configuration and launch files for using the sobit_home with the MoveIt Motion Planning Framework
  </description>
  <maintainer email="dlwnsgh58@gmail.com">j.lee</maintainer>

  <license>BSD-3-Clause</license>

  <url type="website">http://moveit.ros.org/</url>
  <url type="bugtracker">https://github.com/moveit/moveit2/issues</url>
  <url type="repository">https://github.com/moveit/moveit2</url>

  <author email="dlwnsgh58@gmail.com">j.lee</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_perception</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_ros_warehouse</exec_depend>
  <exec_depend>moveit_setup_assistant</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sobit_home_control</exec_depend>
  <exec_depend>sobit_home_description</exec_depend>
  <exec_depend>sobit_home_kinematics_plugin</exec_depend>
  <exec_depend>sobit_home_library</exec_depend>
  <!-- Warehouse backends, selected by warehouse_backend at launch. Only the
       sqlite one is released for Jazzy; warehouse_ros_mongo must be built from
       source, so it is not declared here and stays optional. -->
  <exec_depend>warehouse_ros_sqlite</exec_depend>


  <export>
      <build_type>ament_cmake</build_type>
  </export>
</package>
