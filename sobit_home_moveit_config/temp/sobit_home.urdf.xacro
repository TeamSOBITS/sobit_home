<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sobit_home">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import sobit_home urdf file -->
    <xacro:include filename="$(find sobit_home_description)/robots/sobit_home_robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="sobit_home.ros2_control.xacro" />


    <xacro:sobit_home_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
