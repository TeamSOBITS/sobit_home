<?xml version="1.0" encoding="UTF-8"?>
<!-- This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced
    are defined. -->
<robot name="sobit_home">
    <!--GROUPS:
    Representation of a set of joints and links. This can be useful for specifying DOF to plan for,
    defining arms, end effectors, etc. -->
    <!--LINKS:
    When a link is specified, the parent joint of that link (if it exists) is automatically
    included. -->
    <!--JOINTS:
    When a joint is specified, the child link of that joint (which will always exist) is
    automatically included. -->
    <!--CHAINS:
    When a chain is specified, all the links along the chain (including endpoints) are included in
    the group. Additionally, all the joints that are parents to included links are also included.
    This means that joints along the chain and the parent joint of the base link are included in the
    group. -->
    <!--SUBGROUPS:
    Groups can also be formed by referencing to already defined group names. -->
    <group name="head">
        <joint name="head_pan_joint" />
        <chain base_link="head_pan_link" tip_link="head_tilt_link" />
        <link name="head_tilt_link" />
    </group>

    <group name="arm_left">
        <joint name="arm_left_shoulder_tilt_joint" />
        <chain base_link="arm_left_shoulder_tilt_link" tip_link="arm_left_wrist_roll_link" />
        <link name="hand_left_end_effector_link" />
    </group>
    <group name="arm_right">
        <joint name="arm_right_shoulder_tilt_joint" />
        <chain base_link="arm_right_shoulder_tilt_link" tip_link="arm_right_wrist_roll_link" />
        <link name="hand_right_end_effector_link" />
    </group>
    <group name="arm">
        <group name="arm_left" />
        <group name="arm_right" />
    </group>

    <group name="hand_left_finger_c">
        <joint name="hand_left_finger_c_mcp_joint" />
        <chain base_link="hand_left_finger_c_mcp_link" tip_link="hand_left_finger_c_ip_link" />
        <link name="hand_left_finger_c_ip_link" />
    </group>
    <group name="hand_left_finger_l">
        <joint name="hand_left_cmc_joint" />
        <chain base_link="hand_left_cmc_link" tip_link="hand_left_finger_l_dip_link" />
        <link name="hand_left_finger_l_dip_link" />
    </group>
    <group name="hand_left_finger_r">
        <joint name="hand_left_finger_r_pip_joint" />
        <chain base_link="hand_left_finger_r_pip_link" tip_link="hand_left_finger_r_dip_link" />
        <link name="hand_left_finger_r_dip_link" />
    </group>
    <group name="hand_left">
        <group name="hand_left_finger_c" />
        <group name="hand_left_finger_l" />
        <group name="hand_left_finger_r" />
        <link name="hand_left_end_effector_link" />
    </group>

    <group name="hand_right_finger_c">
        <joint name="hand_right_finger_c_mcp_joint" />
        <chain base_link="hand_right_finger_c_mcp_link" tip_link="hand_right_finger_c_ip_link" />
        <link name="hand_right_finger_c_ip_link" />
    </group>
    <group name="hand_right_finger_l">
        <joint name="hand_right_cmc_joint" />
        <chain base_link="hand_right_cmc_link" tip_link="hand_right_finger_l_dip_link" />
        <link name="hand_right_finger_l_dip_link" />
    </group>
    <group name="hand_right_finger_r">
        <joint name="hand_right_finger_r_pip_joint" />
        <chain base_link="hand_right_finger_r_pip_link" tip_link="hand_right_finger_r_dip_link" />
        <link name="hand_right_finger_r_dip_link" />
    </group>
    <group name="hand_right">
        <group name="hand_right_finger_c" />
        <group name="hand_right_finger_l" />
        <group name="hand_right_finger_r" />
        <link name="hand_right_end_effector_link" />
    </group>

    <group name="body">
        <joint name="body_joint" />
        <chain base_link="body_link" tip_link="body_lift_link" />
        <link name="body_lift_link" />
    </group>
    <group name="arm_left_body">
        <group name="body" />
        <group name="arm_left" />
    </group>
    <group name="arm_right_body">
        <group name="body" />
        <group name="arm_right" />
    </group>
    <group name="arm_body">
        <group name="body" />
        <group name="arm" />
    </group>


    <!-- GROUP STATES
    Purpose: Define a named state for a particular group, in terms of joint values. This is
    useful to define states like 'folded arms'. -->
    <group_state name="initial_pose" group="head">
        <joint name="head_pan_joint" value="0" />
        <joint name="head_tilt_joint" value="0" />
    </group_state>
    <group_state name="initial_pose" group="arm_left">
        <joint name="arm_left_elbow_joint" value="-1.33" />
        <joint name="arm_left_shoulder_tilt_joint" value="0.55" />
        <joint name="arm_left_upper_flex_joint" value="0" />
        <joint name="arm_left_upper_roll_joint" value="-1.5" />
        <joint name="arm_left_wrist_roll_joint" value="0" />
        <joint name="arm_left_wrist_tilt_joint" value="-0.7" />
    </group_state>
    <group_state name="initial_pose" group="body">
        <joint name="body_lift_joint" value="0.5" />
    </group_state>
    <group_state name="initial_pose" group="arm_right">
        <joint name="arm_right_elbow_joint" value="1.33" />
        <joint name="arm_right_shoulder_tilt_joint" value="-0.55" />
        <joint name="arm_right_upper_flex_joint" value="0" />
        <joint name="arm_right_upper_roll_joint" value="1.5" />
        <joint name="arm_right_wrist_roll_joint" value="0" />
        <joint name="arm_right_wrist_tilt_joint" value="0.7" />
    </group_state>
    <group_state name="initial_pose" group="arm">
        <joint name="arm_left_elbow_joint" value="-1.33" />
        <joint name="arm_left_shoulder_tilt_joint" value="0.55" />
        <joint name="arm_left_upper_flex_joint" value="0" />
        <joint name="arm_left_upper_roll_joint" value="-1.5" />
        <joint name="arm_left_wrist_roll_joint" value="0" />
        <joint name="arm_left_wrist_tilt_joint" value="-0.7" />
        <joint name="arm_right_elbow_joint" value="1.33" />
        <joint name="arm_right_shoulder_tilt_joint" value="-0.55" />
        <joint name="arm_right_upper_flex_joint" value="0" />
        <joint name="arm_right_upper_roll_joint" value="1.5" />
        <joint name="arm_right_wrist_roll_joint" value="0" />
        <joint name="arm_right_wrist_tilt_joint" value="0.7" />
    </group_state>
    <group_state name="left_hand_2finger_open" group="hand_left">
        <joint name="hand_left_finger_c_ip_joint" value="-0.5235" />
        <joint name="hand_left_finger_c_mcp_joint" value="-1.5707" />
        <joint name="hand_left_finger_l_dip_joint" value="0.5235" />
        <joint name="hand_left_finger_l_mcp_joint" value="-1.5707" />
        <joint name="hand_left_finger_l_pip_joint" value="1.5707" />
        <joint name="hand_left_finger_r_dip_joint" value="-0.5235" />
        <joint name="hand_left_finger_r_pip_joint" value="-1.5707" />
    </group_state>
    <group_state name="left_hand_3finger_open" group="hand_left">
        <joint name="hand_left_finger_c_ip_joint" value="-0.5235" />
        <joint name="hand_left_finger_c_mcp_joint" value="-1.5707" />
        <joint name="hand_left_finger_l_dip_joint" value="0.5235" />
        <joint name="hand_left_finger_l_mcp_joint" value="-0.7853" />
        <joint name="hand_left_finger_l_pip_joint" value="1.5707" />
        <joint name="hand_left_finger_r_dip_joint" value="-0.5235" />
        <joint name="hand_left_finger_r_pip_joint" value="-1.5707" />
    </group_state>
    <group_state name="right_hand_2finger_open" group="hand_right">
        <joint name="hand_right_finger_c_ip_joint" value="0.5235" />
        <joint name="hand_right_finger_c_mcp_joint" value="1.5707" />
        <joint name="hand_right_finger_l_dip_joint" value="0.5235" />
        <joint name="hand_right_finger_l_mcp_joint" value="1.5707" />
        <joint name="hand_right_finger_l_pip_joint" value="1.5707" />
        <joint name="hand_right_finger_r_dip_joint" value="-0.5235" />
        <joint name="hand_right_finger_r_pip_joint" value="-1.5707" />
    </group_state>
    <group_state name="right_hand_3finger_open" group="hand_right">
        <joint name="hand_right_finger_c_ip_joint" value="0.5235" />
        <joint name="hand_right_finger_c_mcp_joint" value="1.5707" />
        <joint name="hand_right_finger_l_dip_joint" value="0.5235" />
        <joint name="hand_right_finger_l_mcp_joint" value="0.7853" />
        <joint name="hand_right_finger_l_pip_joint" value="1.5707" />
        <joint name="hand_right_finger_r_dip_joint" value="-0.5235" />
        <joint name="hand_right_finger_r_pip_joint" value="-1.5707" />
    </group_state>
    <group_state name="left_hand_2finger_close" group="hand_left">
        <joint name="hand_left_finger_c_ip_joint" value="0.7853" />
        <joint name="hand_left_finger_c_mcp_joint" value="0" />
        <joint name="hand_left_finger_l_dip_joint" value="-0.7853" />
        <joint name="hand_left_finger_l_mcp_joint" value="-1.5707" />
        <joint name="hand_left_finger_l_pip_joint" value="0" />
        <joint name="hand_left_finger_r_dip_joint" value="0.7853" />
        <joint name="hand_left_finger_r_pip_joint" value="0" />
    </group_state>
    <group_state name="left_hand_3finger_close" group="hand_left">
        <joint name="hand_left_finger_c_ip_joint" value="0.7853" />
        <joint name="hand_left_finger_c_mcp_joint" value="0" />
        <joint name="hand_left_finger_l_dip_joint" value="-0.7853" />
        <joint name="hand_left_finger_l_mcp_joint" value="-0.7853" />
        <joint name="hand_left_finger_l_pip_joint" value="0" />
        <joint name="hand_left_finger_r_dip_joint" value="0.7853" />
        <joint name="hand_left_finger_r_pip_joint" value="0" />
    </group_state>
    <group_state name="right_hand_2finger_close" group="hand_right">
        <joint name="hand_right_finger_c_ip_joint" value="-0.7853" />
        <joint name="hand_right_finger_c_mcp_joint" value="0" />
        <joint name="hand_right_finger_l_dip_joint" value="-0.7853" />
        <joint name="hand_right_finger_l_mcp_joint" value="1.5707" />
        <joint name="hand_right_finger_l_pip_joint" value="0" />
        <joint name="hand_right_finger_r_dip_joint" value="0.7853" />
        <joint name="hand_right_finger_r_pip_joint" value="0" />
    </group_state>
    <group_state name="right_hand_3finger_close" group="hand_right">
        <joint name="hand_right_finger_c_ip_joint" value="-0.7853" />
        <joint name="hand_right_finger_c_mcp_joint" value="0" />
        <joint name="hand_right_finger_l_dip_joint" value="-0.7853" />
        <joint name="hand_right_finger_l_mcp_joint" value="0.7853" />
        <joint name="hand_right_finger_l_pip_joint" value="0" />
        <joint name="hand_right_finger_r_dip_joint" value="0.7853" />
        <joint name="hand_right_finger_r_pip_joint" value="0" />
    </group_state>

    <!-- END EFFECTOR
    Purpose: Represent information about an end effector. -->
    <end_effector name="arm_left_ee" parent_link="hand_left_end_effector_link" group="hand_left"
        parent_group="arm_left" />
    <end_effector name="arm_right_ee" parent_link="hand_right_end_effector_link" group="hand_right"
        parent_group="arm_right" />

    <!-- PASSIVE JOINT
    Purpose: this element is used to mark joints that are not actuated. -->
    <passive_joint name="hand_left_finger_r_mcp_joint" />
    <passive_joint name="hand_right_finger_r_mcp_joint" />

    <!-- DISABLE COLLISIONS
    Purpose: By default it is assumed that any link of the robot could potentially come into
    collision with any other link in the robot. This tag disables collision checking between a
    specified pair of links. -->
    <disable_collisions link1="arm_left_base_link" link2="arm_left_elbow_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_left_shoulder_tilt_link"
        reason="Adjacent" />
    <disable_collisions link1="arm_left_base_link" link2="arm_left_upper_flex_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_left_upper_roll_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_left_wrist_tilt_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_right_base_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_right_elbow_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_right_shoulder_tilt_link"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_right_upper_flex_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="arm_right_upper_roll_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="body_lift_link" reason="Adjacent" />
    <disable_collisions link1="arm_left_base_link" link2="body_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="hand_left_finger_c_ip_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="hand_left_finger_l_pip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_base_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_bottom_screw_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_color_frame" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_color_optical_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_depth_frame" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_depth_optical_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_infra2_frame" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_infra2_optical_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_infra_1_frame" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_camera_infra_1_optical_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_pan_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_plug_base_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="head_tilt_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="lidar_back_base_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="lidar_front_base_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="plate_bottom_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="plate_middle_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="plate_top_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_drive_b_l_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_drive_b_r_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_drive_f_l_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_drive_f_r_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_b_l_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_b_r_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_base_b_l_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_base_b_r_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_base_f_l_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_base_f_r_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_f_l_link" reason="Never" />
    <disable_collisions link1="arm_left_base_link" link2="wheel_steer_f_r_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_left_shoulder_tilt_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_left_upper_flex_link"
        reason="Adjacent" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_left_upper_roll_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_left_wrist_roll_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_left_wrist_tilt_link"
        reason="Adjacent" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_right_base_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_right_elbow_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_right_shoulder_tilt_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_right_upper_flex_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="arm_right_upper_roll_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_left_finger_c_ip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_left_finger_c_mcp_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_left_finger_l_dip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_left_finger_l_pip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_left_finger_r_dip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_left_finger_r_pip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_right_finger_c_mcp_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_right_finger_l_dip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="hand_right_finger_l_pip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="lidar_back_base_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="wheel_drive_b_r_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="wheel_drive_f_r_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="wheel_steer_b_r_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="wheel_steer_base_b_r_link" reason="Never" />
    <disable_collisions link1="arm_left_elbow_link" link2="wheel_steer_f_r_link" reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_left_upper_flex_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_left_upper_roll_link"
        reason="Adjacent" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_left_wrist_roll_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_left_wrist_tilt_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_right_base_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_right_elbow_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_right_shoulder_tilt_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_right_upper_flex_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_right_upper_roll_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="arm_right_wrist_tilt_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="body_lift_link" reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="body_link" reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="hand_left_finger_c_ip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="hand_left_finger_c_mcp_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="hand_left_finger_l_dip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="hand_left_finger_l_pip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="hand_left_finger_r_dip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="hand_left_finger_r_pip_link"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_base_link" reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_camera_bottom_screw_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_camera_color_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_camera_color_optical_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_camera_depth_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_camera_depth_optical_frame"
        reason="Never" />
    <disable_collisions link1="arm_left_shoulder_tilt_link" link2="head_camera_infra2_frame"
        reason="Never" />
